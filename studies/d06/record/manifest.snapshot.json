        }
      ]
    },
    {
      "id": "examples",
      "title": "02 修改／移除示例 → 工具選擇與格式",
      "hypothesis": "email_qa 示例是否引導模型先用 email 工具？",
      "change": "A 保留 email 示例；B 只將同一示例換成 search_docs；C 移除完整 interaction 示例。",
      "compare": [
        "a-full",
        "b-full"
      ],
      "observations": [
        "A 的三個起手 response 皆為 email_qa，B 的三個皆為 search_docs。",
        "C 的三次 probe 都漏掉外層 name、args。",
        "A/B 完整 run 仍未答對，皆沒有 read_doc。"
      ],
      "interpretation": "單題／單模型的描述性結果；temperature=0 的重複呼叫不是獨立統計樣本。",
      "pins": [
        {
          "run": "c-probe1",
          "turn": 1,
          "label": "缺少 name / args"
        },
        {
          "run": "b-full",
          "turn": 2,
          "label": "摘要不足後仍搜尋"
        }
      ]
    },
    {
      "id": "protocol",
      "title": "03 明確格式與摘要限制 → 開始讀文件但未翻頁",
      "hypothesis": "不保留 interaction 示例，能否維持合法格式並開始讀取文件？",
      "change": "移除示例；對齊 Tool 名稱、args 與 schema；search_docs 明示只回傳 snippets，必要時用 read_doc。",
      "compare": [
        "protocol-before",
        "protocol-after"
      ],
      "observations": [
        "新版所有呼叫合法，read_doc 由 0 次變為 2 次。",
        "API spec 只取得第 1–89/131 行；沒有繼續 start_line=90。",
        "最終錯答 2027-08-25；正確日期從未進入 request。"
      ],
      "interpretation": "這次是兩項文字修改的合併比較，不能分別估計每一項的效果。",
      "pins": [
        {
          "run": "protocol-after",
          "turn": 5,
          "label": "讀 API spec 首頁"
        },
        {
          "run": "protocol-after",
          "turn": 6,
          "label": "未翻頁便錯答"
        }
      ]
    },
    {
      "id": "paging",
      "title": "04 明確分頁規則 → 重回搜尋迴圈",
      "hypothesis": "明示部分文件與 end_line < total_lines，是否會促成繼續讀取？",
      "change": "只改 read_doc 描述：最多 1500 tokens，未讀完且答案未找到時用相同 doc_id、start_line=end_line+1。",
      "compare": [
        "protocol-after",
        "paging-after"
      ],
      "observations": [
        "6 個主 requests，0 個 aux；5 次工具呼叫合法。",
        "4 次文件搜尋回傳 20 筆、只有 5 份不同文件，完全沒呼叫 read_doc。",
        "turn 2 已從「摘要沒寫」推成「文件沒寫」。"
      ],
      "interpretation": "本次沒有進入翻頁階段，不能宣稱分頁指引已驗證有效。",
      "pins": [
        {
          "run": "paging-after",
          "turn": 2,
          "label": "將摘要推成全文"
        },
        {
          "run": "paging-after",
          "turn": 4,
          "label": "轉向 email"
        },
        {
          "run": "paging-after",
          "turn": 6,
          "label": "搜尋後放棄"
        }
      ]
    },
    {
      "id": "replay",
      "title": "05 固定歷史交叉重播 → 區分描述與歷史",
      "hypothesis": "路徑差異來自新描述，還是前幾輪累積的不同歷史？",
      "change": "固定兩次各自 turn 4 的歷史，各用新／舊描述重播一次，共四個 requests，不執行工具。",
      "compare": [
        "replay-old-old",
        "replay-old-new"
      ],
      "observations": [
        "前次歷史：舊描述選 read_doc，新描述選 search_docs。",
        "本次歷史：舊描述選 search_docs，新描述選 search_emails。",
        "控制重播工具選擇相同，但 completion 文句未逐字相同。"
      ],
      "interpretation": "支持描述與歷史共同影響路徑；每格一次，無法推論模型內部心理原因或一般穩定效果。",
      "pins": [
        {
